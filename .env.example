# ---------------------------------------------------------------------------
# WealthPilot AI — server environment variables
# Copy to .env for local dev; set these as env vars on Cloud Run in production.
# ---------------------------------------------------------------------------

# Port the Express server listens on (Cloud Run injects PORT automatically).
PORT=3000

# NODE_ENV: "development" (Vite middleware) or "production" (serves dist/).
NODE_ENV=development

# GEMINI_API_KEY: required for the AI copilot and per-company stock analysis.
# Get one from Google AI Studio. Keep it SERVER-SIDE only — never expose it to
# the client. If unset, the app degrades gracefully (no fabricated analysis).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Gemini model ids (override if Google changes availability).
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-3.6-flash"

# APP_URL: public URL of the deployed app (used for self-referential links).
APP_URL="http://localhost:3000"

# Rate limiting for the unauthenticated proxy endpoints (per-IP, per-window).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
COPILOT_RATE_LIMIT_MAX=12
